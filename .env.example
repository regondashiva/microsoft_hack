# MemoryAI — AI Content Strategist
# Server-side Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS TO GIT

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MemoryAI"
NEXT_PUBLIC_APP_VERSION="0.3.0-task3"

# Hindsight Persistent Memory Configuration (TASK 2)
# Secure server-side credentials only — NEVER prefix with NEXT_PUBLIC_
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=

# LLM Service Configuration (TASK 3)
# Secure server-side credentials only — NEVER prefix with NEXT_PUBLIC_
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=

# Optional fallback provider variables
OPENAI_API_KEY=

# Telemetry & Diagnostics (Optional)
DEBUG_MODE=false
